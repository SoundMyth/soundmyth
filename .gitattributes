# One line-ending policy for every checkout (Windows included): LF in the repo and in the working copy.
* text=auto eol=lf

# Binary assets: never normalised, never diffed as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.xlsx binary
*.woff  binary
*.woff2 binary
